{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "小说阅读器",
  "version": "1.0.0",
  "identifier": "com.novelreader.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:2048"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
